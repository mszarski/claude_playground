diff --git a/mupen64plus-rsp-cxd4/ls_accurate.h b/mupen64plus-rsp-cxd4/ls_accurate.h
new file mode 100644
index 0000000..bfd902d
--- /dev/null
+++ b/mupen64plus-rsp-cxd4/ls_accurate.h
@@ -0,0 +1,315 @@
+/*
+ * Accurate RSP vector load/store (LWC2/SWC2) implementations for cxd4.
+ *
+ * Ported from parallel-rsp's rsp/ls.cpp (itself based on ares). cxd4's own
+ * versions only implement the element/alignment combinations used by
+ * commercial microcode and print "Illegal element"/"Weird addr" otherwise,
+ * which breaks libdragon/tiny3d microcode. This file is #included at the end
+ * of su.c and the LWC2/SWC2 dispatch tables point at these functions.
+ */
+
+#define ACC_DM_R8(a)      (DMEM[BES((a) & 0xFFFu)])
+#define ACC_DM_W8(a, v)   (DMEM[BES((a) & 0xFFFu)] = (u8)(v))
+#define ACC_VREG(vt)      ((u16 *)&VR[(vt)][0])
+
+static INLINE u8 acc_byte_from_halfwords(const u16 *arr, unsigned i)
+{
+    return (i & 1) ? (u8)(arr[i >> 1] & 0xff) : (u8)(arr[i >> 1] >> 8);
+}
+
+static INLINE void acc_byte_to_halfwords(u16 *arr, unsigned i, u8 b)
+{
+    const unsigned n = i >> 1;
+    if (i & 1)
+        arr[n] = (u16)((arr[n] & 0xff00) | (u16)b);
+    else
+        arr[n] = (u16)((arr[n] & 0x00ff) | ((u16)b << 8));
+}
+
+static void acc_LBV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 1) & 0xfff;
+    acc_byte_to_halfwords(ACC_VREG(rt), e & 0xf, ACC_DM_R8(addr));
+}
+
+static void acc_SBV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 1) & 0xfff;
+    ACC_DM_W8(addr, acc_byte_from_halfwords(ACC_VREG(rt), e & 0xf));
+}
+
+static void acc_LSV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = SR[base] + offset * 2;
+    const unsigned end = (e > 14) ? 16 : (e + 2);
+    unsigned i;
+    for (i = e; i < end; i++)
+        acc_byte_to_halfwords(ACC_VREG(rt), i & 0xf, ACC_DM_R8(addr++));
+}
+
+static void acc_SSV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 2) & 0xfff;
+    ACC_DM_W8(addr, acc_byte_from_halfwords(ACC_VREG(rt), e & 0xf));
+    ACC_DM_W8(addr + 1, acc_byte_from_halfwords(ACC_VREG(rt), (e + 1) & 0xf));
+}
+
+static void acc_LLV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = SR[base] + offset * 4;
+    const unsigned end = (e > 12) ? 16 : (e + 4);
+    unsigned i;
+    for (i = e; i < end; i++)
+        acc_byte_to_halfwords(ACC_VREG(rt), i & 0xf, ACC_DM_R8(addr++));
+}
+
+static void acc_SLV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 4) & 0xfff;
+    unsigned i;
+    for (i = e; i < e + 4; i++)
+        ACC_DM_W8(addr++, acc_byte_from_halfwords(ACC_VREG(rt), i & 0xf));
+}
+
+static void acc_LDV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = SR[base] + offset * 8;
+    const unsigned end = (e > 8) ? 16 : (e + 8);
+    unsigned i;
+    for (i = e; i < end; i++)
+        acc_byte_to_halfwords(ACC_VREG(rt), i & 0xf, ACC_DM_R8(addr++));
+}
+
+static void acc_SDV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 8) & 0xfff;
+    unsigned i;
+    for (i = 0; i < 8; i++)
+        ACC_DM_W8(addr + i, acc_byte_from_halfwords(ACC_VREG(rt), (e + i) & 0xf));
+}
+
+static void acc_LPV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 8) & 0xfff;
+    const unsigned index = (addr & 7) - e;
+    u16 *reg = ACC_VREG(rt);
+    unsigned i;
+    addr &= ~7u;
+    for (i = 0; i < 8; i++)
+        reg[i] = (u16)(ACC_DM_R8(addr + ((i + index) & 0xf)) << 8);
+}
+
+static void acc_SPV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 8) & 0xfff;
+    const u16 *reg = ACC_VREG(rt);
+    unsigned i;
+    for (i = e; i < e + 8; i++) {
+        const unsigned shift = ((i & 0xf) < 8) ? 8 : 7;
+        ACC_DM_W8(addr++, (s16)reg[i & 7] >> shift);
+    }
+}
+
+static void acc_LUV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 8) & 0xfff;
+    const unsigned index = (addr & 7) - e;
+    u16 *reg = ACC_VREG(rt);
+    unsigned i;
+    addr &= ~7u;
+    for (i = 0; i < 8; i++)
+        reg[i] = (u16)(ACC_DM_R8(addr + ((i + index) & 0xf)) << 7);
+}
+
+static void acc_SUV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 8) & 0xfff;
+    const u16 *reg = ACC_VREG(rt);
+    unsigned i;
+    for (i = e; i < e + 8; i++) {
+        const unsigned shift = ((i & 0xf) < 8) ? 7 : 8;
+        ACC_DM_W8(addr++, (s16)reg[i & 7] >> shift);
+    }
+}
+
+static void acc_LHV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = SR[base] + offset * 16;
+    const unsigned index = (addr & 7) - e;
+    u16 *reg = ACC_VREG(rt);
+    unsigned i;
+    addr &= ~7u;
+    for (i = 0; i < 8; i++)
+        reg[i] = (u16)(ACC_DM_R8(addr + ((index + i * 2) & 0xf)) << 7);
+}
+
+static void acc_SHV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 16) & 0xfff;
+    const unsigned index = addr & 7;
+    const u16 *reg = ACC_VREG(rt);
+    unsigned i;
+    addr &= ~7u;
+    for (i = 0; i < 8; i++) {
+        const unsigned b = e + (i << 1);
+        const u8 byte = (u8)((acc_byte_from_halfwords(reg, b & 0xf) << 1) |
+                             (acc_byte_from_halfwords(reg, (b + 1) & 0xf) >> 7));
+        ACC_DM_W8(addr + ((index + i * 2) & 0xf), byte);
+    }
+}
+
+static void acc_LFV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    u16 temp[8];
+    unsigned addr = SR[base] + offset * 16;
+    const unsigned index = (addr & 7) - e;
+    const unsigned end = (e > 8) ? 16 : (e + 8);
+    unsigned i;
+    addr &= ~7u;
+    for (i = 0; i < 4; i++) {
+        temp[i]     = (u16)(ACC_DM_R8(addr + ((index + i * 4) & 0xf)) << 7);
+        temp[i + 4] = (u16)(ACC_DM_R8(addr + ((index + i * 4 + 8) & 0xf)) << 7);
+    }
+    for (i = e; i < end; i++)
+        acc_byte_to_halfwords(ACC_VREG(rt), i, acc_byte_from_halfwords(temp, i));
+}
+
+#define ACC_SFV_CASE(a, b, c, d) \
+    ACC_DM_W8(addr + bse, (s16)reg[a] >> 7); \
+    ACC_DM_W8(addr + 4 + bse, (s16)reg[b] >> 7); \
+    ACC_DM_W8(addr + ((8 + bse) & 0xf), (s16)reg[c] >> 7); \
+    ACC_DM_W8(addr + ((12 + bse) & 0xf), (s16)reg[d] >> 7);
+
+static void acc_SFV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 16) & 0xfff;
+    const unsigned bse = addr & 7;
+    const u16 *reg = ACC_VREG(rt);
+    addr &= ~7u;
+    switch (e) {
+    case 0:
+    case 15: ACC_SFV_CASE(0, 1, 2, 3) break;
+    case 1:  ACC_SFV_CASE(6, 7, 4, 5) break;
+    case 4:  ACC_SFV_CASE(1, 2, 3, 0) break;
+    case 5:  ACC_SFV_CASE(7, 4, 5, 6) break;
+    case 8:  ACC_SFV_CASE(4, 5, 6, 7) break;
+    case 11: ACC_SFV_CASE(3, 0, 1, 2) break;
+    case 12: ACC_SFV_CASE(5, 6, 7, 4) break;
+    default:
+        ACC_DM_W8(addr + bse, 0);
+        ACC_DM_W8(addr + 4 + bse, 0);
+        ACC_DM_W8(addr + ((8 + bse) & 0xf), 0);
+        ACC_DM_W8(addr + ((12 + bse) & 0xf), 0);
+        break;
+    }
+}
+
+static void acc_LWV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = SR[base] + offset * 16;
+    unsigned i;
+    for (i = 16 - e; i < 16 + e; i++) {
+        acc_byte_to_halfwords(ACC_VREG(rt), i & 0xf, ACC_DM_R8(addr));
+        addr += 4;
+    }
+}
+
+static void acc_SWV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 16) & 0xfff;
+    unsigned bse = addr & 7;
+    unsigned i;
+    addr &= ~7u;
+    for (i = e; i < e + 16; i++)
+        ACC_DM_W8(addr + (bse++ & 0xf), acc_byte_from_halfwords(ACC_VREG(rt), i & 0xf));
+}
+
+static void acc_LQV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = SR[base] + offset * 16;
+    unsigned end = 16 + e - (addr & 0xf);
+    unsigned i;
+    if (end > 16) end = 16;
+    for (i = e; i < end; i++)
+        acc_byte_to_halfwords(ACC_VREG(rt), i & 0xf, ACC_DM_R8(addr++));
+}
+
+static void acc_SQV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 16) & 0xfff;
+    const unsigned end = e + (16 - (addr & 15));
+    unsigned i;
+    for (i = e; i < end; i++)
+        ACC_DM_W8(addr++, acc_byte_from_halfwords(ACC_VREG(rt), i & 15));
+}
+
+static void acc_LRV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = SR[base] + offset * 16;
+    const unsigned start = 16 - ((addr & 0xf) - e);
+    unsigned i;
+    addr &= ~0xfu;
+    for (i = start; i < 16; i++)
+        acc_byte_to_halfwords(ACC_VREG(rt), i & 0xf, ACC_DM_R8(addr++));
+}
+
+static void acc_SRV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = (SR[base] + offset * 16) & 0xfff;
+    const unsigned end = e + (addr & 0xf);
+    const unsigned bse = 16 - (addr & 0xf);
+    unsigned i;
+    addr &= ~0xfu;
+    for (i = e; i < end; i++)
+        ACC_DM_W8(addr++, acc_byte_from_halfwords(ACC_VREG(rt), (i + bse) & 0xf));
+}
+
+static void acc_LTV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr = SR[base] + offset * 16;
+    const unsigned start = addr & ~7u;
+    const unsigned vt0 = rt & ~7u;
+    unsigned j = e >> 1;
+    unsigned i;
+    addr = start + ((e + (addr & 8)) & 0xf);
+    for (i = 0; i < 16; j++) {
+        j &= 7;
+        acc_byte_to_halfwords(ACC_VREG(vt0 + j), i++, ACC_DM_R8(addr++));
+        if (addr == start + 16) addr = start;
+        acc_byte_to_halfwords(ACC_VREG(vt0 + j), i++, ACC_DM_R8(addr++));
+        if (addr == start + 16) addr = start;
+    }
+}
+
+static void acc_STV(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    unsigned addr, element, bse, i;
+    e &= ~1u;
+    rt &= ~7u;
+    addr = (SR[base] + offset * 16) & 0xfff;
+    element = 16 - e;
+    bse = (addr & 7) - e;
+    addr &= ~7u;
+    for (i = rt; i < rt + 8; i++) {
+        ACC_DM_W8(addr + (bse++ & 0xf), acc_byte_from_halfwords(ACC_VREG(i), element++ & 0xf));
+        ACC_DM_W8(addr + (bse++ & 0xf), acc_byte_from_halfwords(ACC_VREG(i), element++ & 0xf));
+    }
+}
+
+static void acc_res_lsw(unsigned rt, unsigned e, signed offset, unsigned base)
+{
+    (void)rt; (void)e; (void)offset; (void)base;
