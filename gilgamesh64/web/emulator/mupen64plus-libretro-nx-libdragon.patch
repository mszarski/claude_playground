 void check_int_handler(void* opaque)
 {
-    exception_general((struct r4300_core*)opaque);
+    struct r4300_core* r4300 = (struct r4300_core*)opaque;
+    uint32_t* cp0_regs = r4300_cp0_regs(&r4300->cp0);
