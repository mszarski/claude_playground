diff --git a/mupen64plus-rsp-paraLLEl/rsp_interp.cpp b/mupen64plus-rsp-paraLLEl/rsp_interp.cpp
new file mode 100644
index 0000000..d60501e
--- /dev/null
+++ b/mupen64plus-rsp-paraLLEl/rsp_interp.cpp
@@ -0,0 +1,282 @@
+// Portable interpreter backend for parallel-rsp (see rsp_interp.hpp).
+
+#include "rsp_interp.hpp"
+
+namespace RSP
+{
+namespace Interp
+{
+CPU::CPU()
+{
+}
+
+#define DMEM_BYTES(st) (reinterpret_cast<uint8_t *>((st).dmem))
+#define DMEM_B(st, a) (DMEM_BYTES(st)[((a) ^ 3) & 0xfffu])
+
+static inline uint32_t load_u8(CPUState &st, uint32_t addr)
+{
+	return DMEM_B(st, addr);
+}
+
+static inline uint32_t load_u16(CPUState &st, uint32_t addr)
+{
+	addr &= 0xfffu;
+	if (!(addr & 1))
+		return reinterpret_cast<const uint16_t *>(st.dmem)[(addr ^ 2) >> 1];
+	return (DMEM_B(st, addr) << 8) | DMEM_B(st, addr + 1);
+}
+
+static inline uint32_t load_u32(CPUState &st, uint32_t addr)
+{
+	addr &= 0xfffu;
+	if (!(addr & 3))
+		return st.dmem[addr >> 2];
+	return (DMEM_B(st, addr) << 24) | (DMEM_B(st, addr + 1) << 16) | (DMEM_B(st, addr + 2) << 8) |
+	       DMEM_B(st, addr + 3);
+}
+
+static inline void store_u8(CPUState &st, uint32_t addr, uint32_t v)
+{
+	DMEM_B(st, addr) = uint8_t(v);
+}
+
+static inline void store_u16(CPUState &st, uint32_t addr, uint32_t v)
+{
+	addr &= 0xfffu;
+	if (!(addr & 1))
+	{
+		reinterpret_cast<uint16_t *>(st.dmem)[(addr ^ 2) >> 1] = uint16_t(v);
+		return;
+	}
+	DMEM_B(st, addr) = uint8_t(v >> 8);
+	DMEM_B(st, addr + 1) = uint8_t(v);
+}
+
+static inline void store_u32(CPUState &st, uint32_t addr, uint32_t v)
+{
+	addr &= 0xfffu;
+	if (!(addr & 3))
+	{
+		st.dmem[addr >> 2] = v;
+		return;
+	}
+	DMEM_B(st, addr) = uint8_t(v >> 24);
+	DMEM_B(st, addr + 1) = uint8_t(v >> 16);
+	DMEM_B(st, addr + 2) = uint8_t(v >> 8);
+	DMEM_B(st, addr + 3) = uint8_t(v);
+}
+
+using VUOp = void (*)(RSP::CPUState *, unsigned vd, unsigned vs, unsigned vt, unsigned e);
+static const VUOp vu_ops[64] = {
+	RSP_VMULF, RSP_VMULU, RSP_VRNDP, RSP_VMULQ, RSP_VMUDL, RSP_VMUDM, RSP_VMUDN, RSP_VMUDH, RSP_VMACF, RSP_VMACU, RSP_VRNDN,
+	RSP_VMACQ, RSP_VMADL, RSP_VMADM, RSP_VMADN, RSP_VMADH, RSP_VADD, RSP_VSUB, nullptr, RSP_VABS, RSP_VADDC, RSP_VSUBC,
+	nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, RSP_VSAR, nullptr, nullptr, RSP_VLT,
+	RSP_VEQ, RSP_VNE, RSP_VGE, RSP_VCL, RSP_VCH, RSP_VCR, RSP_VMRG, RSP_VAND, RSP_VNAND, RSP_VOR, RSP_VNOR,
+	RSP_VXOR, RSP_VNXOR, nullptr, nullptr, RSP_VRCP, RSP_VRCPL, RSP_VRCPH, RSP_VMOV, RSP_VRSQ, RSP_VRSQL, RSP_VRSQH,
+	RSP_VNOP, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, RSP_VNOP
+};
+
+using LSOp = void (*)(RSP::CPUState *, unsigned rt, unsigned e, int offset, unsigned base);
+static const LSOp lwc2_ops[32] = {
+	RSP_LBV, RSP_LSV, RSP_LLV, RSP_LDV, RSP_LQV, RSP_LRV, RSP_LPV, RSP_LUV, RSP_LHV, RSP_LFV, nullptr, RSP_LTV,
+};
+static const LSOp swc2_ops[32] = {
+	RSP_SBV, RSP_SSV, RSP_SLV, RSP_SDV, RSP_SQV, RSP_SRV, RSP_SPV, RSP_SUV, RSP_SHV, RSP_SFV, RSP_SWV, RSP_STV,
+};
+
+ReturnMode CPU::run()
+{
+	CPUState &st = state;
+	uint32_t *sr = st.sr;
+	uint32_t pc = st.pc & 0xffcu;
+	bool delay_pending = st.has_delay_slot != 0;
+	uint32_t delay_target = st.branch_target & 0xffcu;
+	st.has_delay_slot = 0;
+
+	for (unsigned n = 0;; n++)
+	{
+		// Yield back to the host CPU once in a while so that a microcode
+		// spinning on a register we don't track can't hang the emulator.
+		if (n >= budget && !delay_pending)
+		{
+			st.pc = pc;
+			return MODE_CONTINUE;
+		}
+
+		const uint32_t instr = st.imem[pc >> 2];
+		uint32_t next = (pc + 4) & 0xffcu;
+		if (delay_pending)
+		{
+			// This instruction is in a branch delay slot.
+			next = delay_target;
+			delay_pending = false;
+		}
+
+		bool take = false;
+		uint32_t target = 0;
+		int exit_mode = MODE_CONTINUE;
+
+		const unsigned op = instr >> 26;
+		const unsigned rs = (instr >> 21) & 31;
+		const unsigned rt = (instr >> 16) & 31;
+		const unsigned rd = (instr >> 11) & 31;
+		const unsigned sa = (instr >> 6) & 31;
+		const int32_t simm = int16_t(instr);
+		const uint32_t uimm = uint16_t(instr);
+		const uint32_t btarget = (pc + 4 + (uint32_t(simm) << 2)) & 0xffcu;
+
+		switch (op)
+		{
+		case 000: // SPECIAL
+			switch (instr & 63)
+			{
+			case 000: sr[rd] = sr[rt] << sa; break;                                  // SLL
+			case 002: sr[rd] = sr[rt] >> sa; break;                                  // SRL
+			case 003: sr[rd] = uint32_t(int32_t(sr[rt]) >> sa); break;               // SRA
+			case 004: sr[rd] = sr[rt] << (sr[rs] & 31); break;                       // SLLV
+			case 006: sr[rd] = sr[rt] >> (sr[rs] & 31); break;                       // SRLV
+			case 007: sr[rd] = uint32_t(int32_t(sr[rt]) >> (sr[rs] & 31)); break;    // SRAV
+			case 010: // JR
+				take = true;
+				target = sr[rs] & 0xffcu;
+				break;
+			case 011: // JALR
+				take = true;
+				target = sr[rs] & 0xffcu;
+				sr[rd] = (pc + 8) & 0xffcu;
+				break;
+			case 015: // BREAK
+				*st.cp0.cr[CP0_REGISTER_SP_STATUS] |= SP_STATUS_BROKE | SP_STATUS_HALT;
+				if (*st.cp0.cr[CP0_REGISTER_SP_STATUS] & SP_STATUS_INTR_BREAK)
+					*st.cp0.irq |= 1;
+				sr[0] = 0;
+				st.pc = next;
+				return MODE_BREAK;
+			case 040: case 041: sr[rd] = sr[rs] + sr[rt]; break;                    // ADD/ADDU
+			case 042: case 043: sr[rd] = sr[rs] - sr[rt]; break;                    // SUB/SUBU
+			case 044: sr[rd] = sr[rs] & sr[rt]; break;                               // AND
+			case 045: sr[rd] = sr[rs] | sr[rt]; break;                               // OR
+			case 046: sr[rd] = sr[rs] ^ sr[rt]; break;                               // XOR
+			case 047: sr[rd] = ~(sr[rs] | sr[rt]); break;                            // NOR
+			case 052: sr[rd] = int32_t(sr[rs]) < int32_t(sr[rt]) ? 1 : 0; break;     // SLT
+			case 053: sr[rd] = sr[rs] < sr[rt] ? 1 : 0; break;                       // SLTU
+			default: break;
+			}
+			break;
+
+		case 001: // REGIMM
+		{
+			const bool neg = int32_t(sr[rs]) < 0;
+			switch (rt)
+			{
+			case 000: take = neg; break;   // BLTZ
+			case 001: take = !neg; break;  // BGEZ
+			case 020: take = neg; sr[31] = (pc + 8) & 0xffcu; break;  // BLTZAL
+			case 021: take = !neg; sr[31] = (pc + 8) & 0xffcu; break; // BGEZAL
+			default: break;
+			}
+			target = btarget;
+			break;
+		}
+
+		case 002: // J
+			take = true;
+			target = (instr << 2) & 0xffcu;
+			break;
+		case 003: // JAL
+			take = true;
+			target = (instr << 2) & 0xffcu;
+			sr[31] = (pc + 8) & 0xffcu;
+			break;
+		case 004: take = sr[rs] == sr[rt]; target = btarget; break;          // BEQ
+		case 005: take = sr[rs] != sr[rt]; target = btarget; break;          // BNE
+		case 006: take = int32_t(sr[rs]) <= 0; target = btarget; break;      // BLEZ
+		case 007: take = int32_t(sr[rs]) > 0; target = btarget; break;       // BGTZ
+
+		case 010: case 011: sr[rt] = sr[rs] + uint32_t(simm); break;                 // ADDI/ADDIU
+		case 012: sr[rt] = int32_t(sr[rs]) < simm ? 1 : 0; break;                    // SLTI
+		case 013: sr[rt] = sr[rs] < uint32_t(simm) ? 1 : 0; break;                   // SLTIU
+		case 014: sr[rt] = sr[rs] & uimm; break;                                     // ANDI
+		case 015: sr[rt] = sr[rs] | uimm; break;                                     // ORI
+		case 016: sr[rt] = sr[rs] ^ uimm; break;                                     // XORI
+		case 017: sr[rt] = uimm << 16; break;                                        // LUI
+
+		case 020: // COP0
+			if (rs == 000)
+				exit_mode = RSP_MFC0(&st, rt, rd);
+			else if (rs == 004)
+				exit_mode = RSP_MTC0(&st, rd, rt);
+			break;
+
+		case 022: // COP2
+			if (instr & (1u << 25))
+			{
+				VUOp vop = vu_ops[instr & 63];
+				if (!vop)
+					vop = RSP_RESERVED;
+				vop(&st, (instr >> 6) & 31, (instr >> 11) & 31, (instr >> 16) & 31, (instr >> 21) & 15);
+			}
+			else
+			{
+				const unsigned e = (instr >> 7) & 15;
+				switch (rs)
+				{
+				case 000: RSP_MFC2(&st, rt, rd, e); break;
+				case 002: RSP_CFC2(&st, rt, rd); break;
+				case 004: RSP_MTC2(&st, rt, rd, e); break;
+				case 006: RSP_CTC2(&st, rt, rd); break;
+				default: break;
+				}
+			}
+			break;
+
+		case 040: sr[rt] = uint32_t(int32_t(int8_t(load_u8(st, sr[rs] + simm)))); break;   // LB
+		case 041: sr[rt] = uint32_t(int32_t(int16_t(load_u16(st, sr[rs] + simm)))); break; // LH
+		case 043: case 047: sr[rt] = load_u32(st, sr[rs] + simm); break;                   // LW/LWU
+		case 044: sr[rt] = load_u8(st, sr[rs] + simm); break;                              // LBU
+		case 045: sr[rt] = load_u16(st, sr[rs] + simm); break;                             // LHU
+		case 050: store_u8(st, sr[rs] + simm, sr[rt]); break;                              // SB
+		case 051: store_u16(st, sr[rs] + simm, sr[rt]); break;                             // SH
+		case 053: store_u32(st, sr[rs] + simm, sr[rt]); break;                             // SW
+
+		case 062: // LWC2
+		case 072: // SWC2
+		{
+			int16_t off = int16_t(instr);
+			off = int16_t(off << 9);
+			off = int16_t(off >> 9);
+			const unsigned e = (instr >> 7) & 15;
+			LSOp lop = (op == 062) ? lwc2_ops[rd] : swc2_ops[rd];
+			if (lop)
+				lop(&st, rt, e, off, rs);
+			break;
+		}
+
+		default:
+			break;
+		}
+
+		sr[0] = 0;
+
+		if (exit_mode != MODE_CONTINUE)
+		{
+			// MFC0/MTC0 may ask us to stop: SP halted, an interrupt was raised,
+			// or a DMA wrote to IMEM (irrelevant for an interpreter).
+			st.dirty_blocks = 0;
+			if ((*st.cp0.cr[CP0_REGISTER_SP_STATUS] & SP_STATUS_HALT) || (*st.cp0.irq & 1))
+			{
+				st.pc = next;
+				return MODE_CHECK_FLAGS;
+			}
+		}
+
+		if (take)
+		{
+			delay_pending = true;
+			delay_target = target;
+		}
+		pc = next;
+	}
+}
+} // namespace Interp
+} // namespace RSP
diff --git a/mupen64plus-rsp-paraLLEl/rsp_interp.hpp b/mupen64plus-rsp-paraLLEl/rsp_interp.hpp
new file mode 100644
index 0000000..c839e9c
--- /dev/null
+++ b/mupen64plus-rsp-paraLLEl/rsp_interp.hpp
@@ -0,0 +1,50 @@
+#ifndef RSP_INTERP_HPP__
+#define RSP_INTERP_HPP__
+
+// Portable (no JIT) interpreter backend for parallel-rsp.
+// Scalar instructions are interpreted here; COP0/COP2/LWC2/SWC2 reuse
+// parallel-rsp's accurate helper functions (rsp/*.cpp, arch/simd/rsp/*.cpp).
+// Used for targets without a usable JIT, e.g. Emscripten/WebAssembly.
+
+#include <stdint.h>
+#include <string.h>
+
+#include "rsp_op.hpp"
+#include "state.hpp"
+
+namespace RSP
+{
+namespace Interp
+{
+class alignas(64) CPU
+{
+public:
+	CPU();
+
+	CPU(CPU &&) = delete;
+	void operator=(CPU &&) = delete;
+
+	void set_dmem(uint32_t *dmem) { state.dmem = dmem; }
+	void set_imem(uint32_t *imem) { state.imem = imem; }
+	void set_rdram(uint32_t *rdram) { state.rdram = rdram; }
+
+	// The interpreter always fetches from IMEM directly; nothing to invalidate.
+	void invalidate_imem() {}
+
+	CPUState &get_state() { return state; }
+
+	// Runs until BREAK (MODE_BREAK), until a COP0 access requests a flag
+	// check (MODE_CHECK_FLAGS), or until the instruction budget is exhausted
+	// (MODE_CONTINUE: RSP is still running, caller should yield to the CPU).
+	ReturnMode run();
+
+	// Max instructions executed per run() call before yielding.
+	unsigned budget = 1u << 22;
+
+private:
+	CPUState state;
+};
+} // namespace Interp
+} // namespace RSP
+
+#endif
