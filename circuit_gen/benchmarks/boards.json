     28
    ]
   },
   {
    "name": "gain ~20 at 100 Hz into 10k",
    "analysis": "ac",
    "freq": 100,
    "sources": {
     "VCC": 9,
     "IN": "ac"
    },
    "loads": {
     "OUT": 10000
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     14,
     28
    ]
   }
  ]
 },
 {
