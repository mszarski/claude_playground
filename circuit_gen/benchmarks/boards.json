[
 {
  "id": "led_resistor",
  "description": "A small board that lights a red LED from a 5 V supply on a 2-pin header, with a current-limiting resistor for about 10 mA. Name the supply nets VCC and GND.",
  "tests": [
   {
    "name": "LED current ~10 mA",
    "sources": {
     "VCC": 5
    },
    "measure": "i(VCC)",
    "expect": [
     0.008,
     0.012
    ]
   },
   {
    "name": "LED current at 4.75 V",
    "sources": {
     "VCC": 4.75
    },
    "measure": "i(VCC)",
    "expect": [
     0.0075,
     0.0125
    ]
   },
   {
    "name": "LED current at 5.25 V",
    "sources": {
     "VCC": 5.25
    },
    "measure": "i(VCC)",
    "expect": [
     0.0075,
     0.0125
    ]
   }
  ]
 },
 {
  "id": "reg_12v_5v",
  "description": "12 V to 5 V regulator board for up to 100 mA using a 78xx-style linear regulator, with input and output 2-pin headers and a green power LED on the output. Name the nets VIN, +5V and GND.",
  "tests": [
   {
    "name": "5 V at 100 mA load",
    "sources": {
     "VIN": 12
    },
    "loads": {
     "+5V": 50
    },
    "measure": "v(+5V)",
    "expect": [
     4.75,
     5.25
    ]
   },
   {
    "name": "5 V with no load",
    "sources": {
     "VIN": 12
    },
    "measure": "v(+5V)",
    "expect": [
     4.75,
     5.25
    ]
   },
   {
    "name": "power LED current limited",
    "sources": {
     "VIN": 12
    },
    "measure": "i(VIN)",
    "expect": [
     0.0005,
     0.02
    ]
   }
  ]
 },
 {
  "id": "alternating_blinker",
  "description": "Two LEDs that blink alternately at about 1 Hz, driven by a 555 timer, powered from 5 V through a 2-pin header. Name the supply nets VCC and GND, and the 555 output net OUT.",
  "tests": [
   {
    "name": "blinks at ~1 Hz",
    "analysis": "tran",
    "duration": 8,
    "sources": {
     "VCC": 5
    },
    "measure": "freq(OUT)",
    "expect": [
     0.7,
     1.4
    ]
   },
   {
    "name": "supply current limited",
    "sources": {
     "VCC": 5
    },
    "measure": "i(VCC)",
    "expect": [
     0.001,
     0.06
    ]
   }
  ]
 },
 {
  "id": "usb_c_power",
  "description": "A USB-C receptacle that provides 5 V to a 2-pin output header. Include the 5.1k CC pull-down resistors so chargers supply 5 V, and a power LED. Name the nets VBUS, GND, CC1 and CC2.",
  "tests": [
   {
    "name": "CC1 pull-down 5.1k",
    "sources": {
     "VBUS": 5,
     "CC1": 1
    },
    "measure": "i(CC1)",
    "expect": [
     0.000179,
     0.000217
    ]
   },
   {
    "name": "CC2 pull-down 5.1k",
    "sources": {
     "VBUS": 5,
     "CC2": 1
    },
    "measure": "i(CC2)",
    "expect": [
     0.000179,
     0.000217
    ]
   },
   {
    "name": "power LED current limited",
    "sources": {
     "VBUS": 5
    },
    "measure": "i(VBUS)",
    "expect": [
     0.0005,
     0.02
    ]
   }
  ]
 },
 {
  "id": "mic_preamp",
  "description": "Single-supply 5 V microphone preamp for an electret mic: mic bias resistor, op-amp non-inverting stage with a gain of about 100 from 300 Hz to 3 kHz, mid-supply reference, AC-coupled input and output. Mic input, power and audio output on pin headers. Name the nets VCC, GND, MIC and AUDIO_OUT.",
  "tests": [
   {
    "name": "gain ~100 at 1 kHz",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "VCC": 5,
     "MIC": "ac"
    },
    "loads": {
     "AUDIO_OUT": 10000
    },
    "measure": "gain(AUDIO_OUT,MIC)",
    "expect": [
     70,
     140
    ]
   },
   {
    "name": "gain ~100 at 300 Hz",
    "analysis": "ac",
    "freq": 300,
    "sources": {
     "VCC": 5,
     "MIC": "ac"
    },
    "loads": {
     "AUDIO_OUT": 10000
    },
    "measure": "gain(AUDIO_OUT,MIC)",
    "expect": [
     70,
     140
    ]
   },
   {
    "name": "mic bias current",
    "sources": {
     "VCC": 5,
     "MIC": 0
    },
    "measure": "i(MIC)",
    "expect": [
     0.0005,
     0.005
    ]
   }
  ]
 },
 {
  "id": "i2c_sensor_breakout",
  "description": "Breakout board for a BME280 temperature/humidity/pressure sensor on I2C, powered from 3.3 V, with 4.7k I2C pull-ups and a 4-pin header. Name the nets VCC, GND, SCL and SDA.",
  "tests": [
   {
    "name": "SDA pull-up 4.7k",
    "sources": {
     "VCC": 3.3,
     "SDA": 0
    },
    "measure": "i(SDA)",
    "expect": [
     0.00055,
     0.00085
    ]
   },
   {
    "name": "SCL pull-up 4.7k",
    "sources": {
     "VCC": 3.3,
     "SCL": 0
    },
    "measure": "i(SCL)",
    "expect": [
     0.00055,
     0.00085
    ]
   },
   {
    "name": "SDA idles high",
    "sources": {
     "VCC": 3.3
    },
    "measure": "v(SDA)",
    "expect": [
