[
 {
  "id": "led_resistor",
  "description": "A small board that lights a red LED from a 5 V supply on a 2-pin header, with a current-limiting resistor for about 10 mA. Name the supply nets VCC and GND.",
  "tests": [
   {
    "name": "LED current ~10 mA",
    "sources": {
     "VCC": 5
    },
    "measure": "i(VCC)",
    "expect": [
     0.008,
     0.012
    ]
   },
   {
    "name": "LED current at 4.75 V",
    "sources": {
     "VCC": 4.75
    },
    "measure": "i(VCC)",
    "expect": [
     0.0075,
     0.0125
    ]
   },
   {
    "name": "LED current at 5.25 V",
    "sources": {
     "VCC": 5.25
    },
    "measure": "i(VCC)",
    "expect": [
     0.0075,
     0.0125
    ]
   }
  ]
 },
 {
  "id": "reg_12v_5v",
  "description": "12 V to 5 V regulator board for up to 100 mA using a 78xx-style linear regulator, with input and output 2-pin headers and a green power LED on the output. Name the nets VIN, +5V and GND.",
  "tests": [
   {
    "name": "5 V at 100 mA load",
    "sources": {
     "VIN": 12
    },
    "loads": {
     "+5V": 50
    },
    "measure": "v(+5V)",
    "expect": [
     4.75,
     5.25
    ]
   },
   {
    "name": "5 V with no load",
    "sources": {
     "VIN": 12
    },
    "measure": "v(+5V)",
    "expect": [
     4.75,
     5.25
    ]
   },
   {
    "name": "power LED current limited",
    "sources": {
     "VIN": 12
    },
    "measure": "i(VIN)",
    "expect": [
     0.0005,
     0.02
    ]
   }
  ]
 },
 {
  "id": "alternating_blinker",
  "description": "Two LEDs that blink alternately at about 1 Hz, driven by a 555 timer, powered from 5 V through a 2-pin header. Name the supply nets VCC and GND, and the 555 output net OUT.",
  "tests": [
   {
    "name": "blinks at ~1 Hz",
    "analysis": "tran",
    "duration": 8,
    "sources": {
     "VCC": 5
    },
    "measure": "freq(OUT)",
    "expect": [
     0.7,
     1.4
    ]
   },
   {
    "name": "supply current limited",
    "sources": {
     "VCC": 5
    },
    "measure": "i(VCC)",
    "expect": [
     0.001,
     0.06
    ]
   }
  ]
 },
 {
  "id": "usb_c_power",
  "description": "A USB-C receptacle that provides 5 V to a 2-pin output header. Include the 5.1k CC pull-down resistors so chargers supply 5 V, and a power LED. Name the nets VBUS, GND, CC1 and CC2.",
  "tests": [
   {
    "name": "CC1 pull-down 5.1k",
    "sources": {
     "VBUS": 5,
     "CC1": 1
    },
    "measure": "i(CC1)",
    "expect": [
     0.000179,
     0.000217
    ]
   },
   {
    "name": "CC2 pull-down 5.1k",
    "sources": {
     "VBUS": 5,
     "CC2": 1
    },
    "measure": "i(CC2)",
    "expect": [
     0.000179,
     0.000217
    ]
   },
   {
    "name": "power LED current limited",
    "sources": {
     "VBUS": 5
    },
    "measure": "i(VBUS)",
    "expect": [
     0.0005,
     0.02
    ]
   }
  ]
 },
 {
  "id": "mic_preamp",
  "description": "Single-supply 5 V microphone preamp for an electret mic: mic bias resistor, op-amp non-inverting stage with a gain of about 100 at 1 kHz, mid-supply reference, AC-coupled input and output. Mic input, power and audio output on pin headers. Name the nets VCC, GND, MIC and AUDIO_OUT.",
  "tests": [
   {
    "name": "gain ~100 at 1 kHz",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "VCC": 5,
     "MIC": "ac"
    },
    "loads": {
     "AUDIO_OUT": 10000
    },
    "measure": "gain(AUDIO_OUT,MIC)",
    "expect": [
     70,
     140
    ]
   },
   {
    "name": "gain ~100 at 300 Hz",
    "analysis": "ac",
    "freq": 300,
    "sources": {
     "VCC": 5,
     "MIC": "ac"
    },
    "loads": {
     "AUDIO_OUT": 10000
    },
    "measure": "gain(AUDIO_OUT,MIC)",
    "expect": [
     70,
     140
    ]
   },
   {
    "name": "mic bias current",
    "sources": {
     "VCC": 5,
     "MIC": 0
    },
    "measure": "i(MIC)",
    "expect": [
     0.0005,
     0.005
    ]
   }
  ]
 },
 {
  "id": "i2c_sensor_breakout",
  "description": "Breakout board for a BME280 temperature/humidity/pressure sensor on I2C, powered from 3.3 V, with 4.7k I2C pull-ups and a 4-pin header. Name the nets VCC, GND, SCL and SDA.",
  "tests": [
   {
    "name": "SDA pull-up 4.7k",
    "sources": {
     "VCC": 3.3,
     "SDA": 0
    },
    "measure": "i(SDA)",
    "expect": [
     0.00055,
     0.00085
    ]
   },
   {
    "name": "SCL pull-up 4.7k",
    "sources": {
     "VCC": 3.3,
     "SCL": 0
    },
    "measure": "i(SCL)",
    "expect": [
     0.00055,
     0.00085
    ]
   },
   {
    "name": "SDA idles high",
    "sources": {
     "VCC": 3.3
    },
    "measure": "v(SDA)",
    "expect": [
     3.2,
     3.35
    ]
   }
  ]
 },
 {
  "id": "button_debounce",
  "description": "Push button with RC debouncing feeding a 74HC14 Schmitt-trigger inverter, 5 V supply, output on a 3-pin header. OUT is low while the button is released and high while it is pressed. Name the nets VCC, GND and OUT.",
  "tests": [
   {
    "name": "OUT low with the button released",
    "sources": {
     "VCC": 5
    },
    "measure": "v(OUT)",
    "expect": [
     0,
     0.5
    ]
   },
   {
    "name": "supply current small with the button released",
    "sources": {
     "VCC": 5
    },
    "measure": "i(VCC)",
    "expect": [
     0,
     0.002
    ]
   }
  ]
 },
 {
  "id": "mosfet_switch",
  "description": "Low-side N-channel MOSFET switch that lets a 3.3 V logic signal switch a 12 V, 1 A load, with gate resistor, gate pull-down, and a flyback diode for inductive loads. Headers or screw terminals for 12 V in, the load, and the logic input. The load connects between V12 and LOAD_NEG. Name the nets V12, GND, LOAD_NEG and CTRL.",
  "tests": [
   {
    "name": "load on at CTRL=3.3 V",
    "sources": {
     "V12": 12,
     "CTRL": 3.3
    },
    "loads": {
     "LOAD_NEG": {
      "to": "V12",
      "r": 12
     }
    },
    "measure": "v(LOAD_NEG)",
    "expect": [
     0,
     0.6
    ]
   },
   {
    "name": "load off at CTRL=0 V",
    "sources": {
     "V12": 12,
     "CTRL": 0
    },
    "loads": {
     "LOAD_NEG": {
      "to": "V12",
      "r": 12
     }
    },
    "measure": "v(LOAD_NEG)",
    "expect": [
     11.4,
     12.1
    ]
   },
   {
    "name": "load off with CTRL floating",
    "sources": {
     "V12": 12
    },
    "loads": {
     "LOAD_NEG": {
      "to": "V12",
      "r": 12
     }
    },
    "measure": "v(LOAD_NEG)",
    "expect": [
     11.4,
     12.1
    ]
   }
  ]
 },
 {
  "id": "attiny_blinky",
  "description": "ATtiny85 microcontroller board with a 6-pin ISP programming header, an LED on PB0, decoupling, and a 2-pin 5 V power header. Name the supply nets VCC and GND.",
  "tests": [
   {
    "name": "no supply short at 5 V",
    "sources": {
     "VCC": 5
    },
    "measure": "i(VCC)",
    "expect": [
     0,
     0.002
    ]
   },
   {
    "name": "no supply short at 5.5 V",
    "sources": {
     "VCC": 5.5
    },
    "measure": "i(VCC)",
    "expect": [
     0,
     0.002
    ]
   }
  ]
 },
 {
  "id": "rs485_transceiver",
  "description": "RS-485 transceiver breakout using a MAX485-compatible chip at 5 V, with a 120 ohm termination resistor, and headers for the UART side (RO, DI, DE/RE, VCC, GND) and the bus side (A, B, GND). Name the bus nets A and B, and the supply nets VCC and GND.",
  "tests": [
   {
    "name": "120 ohm termination",
    "sources": {
     "A": 1,
     "B": 0
    },
    "measure": "i(A)",
    "expect": [
     0.0077,
     0.0091
    ]
   },
   {
    "name": "120 ohm termination, B side",
    "sources": {
     "A": 0,
     "B": 1
    },
    "measure": "i(B)",
    "expect": [
     0.0077,
     0.0091
    ]
   }
  ]
 },
 {
  "id": "rc_lowpass",
  "description": "Passive first-order RC low-pass filter with a 1 kHz cutoff, input and output on 2-pin headers. Name the nets IN, OUT and GND.",
  "tests": [
   {
    "name": "-3 dB at 1 kHz",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0.64,
     0.77
    ]
   },
   {
    "name": "attenuates 10 kHz",
    "analysis": "ac",
    "freq": 10000,
    "sources": {
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0,
     0.15
    ]
   },
   {
    "name": "passes 100 Hz",
    "analysis": "ac",
    "freq": 100,
    "sources": {
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0.95,
     1.0
    ]
   }
  ]
 },
 {
  "id": "buffered_reference",
  "description": "A 2.5 V reference made from a resistor divider on a 5 V supply, buffered by an op-amp voltage follower so it can drive a 1k load. Power and the reference output on pin headers. Name the nets VCC, GND and VREF_OUT.",
  "tests": [
   {
    "name": "2.5 V into 1k",
    "sources": {
     "VCC": 5
    },
    "loads": {
     "VREF_OUT": 1000
    },
    "measure": "v(VREF_OUT)",
    "expect": [
     2.4,
     2.6
    ]
   },
   {
    "name": "2.5 V unloaded",
    "sources": {
     "VCC": 5
    },
    "measure": "v(VREF_OUT)",
    "expect": [
     2.4,
     2.6
    ]
   },
   {
    "name": "2.5 V into 10k",
    "sources": {
     "VCC": 5
    },
    "loads": {
     "VREF_OUT": 10000
    },
    "measure": "v(VREF_OUT)",
    "expect": [
     2.4,
     2.6
    ]
   }
  ]
 },
 {
  "id": "sallen_key_lowpass",
  "description": "Second-order Butterworth low-pass filter (Sallen-Key, unity gain) with a 1 kHz cutoff, using an op-amp on +/-12 V supplies. Input, output and power on pin headers. Name the nets IN, OUT, VPOS (+12 V), VNEG (-12 V) and GND.",
  "tests": [
   {
    "name": "passband ~1 at 100 Hz",
    "analysis": "ac",
    "freq": 100,
    "sources": {
     "VPOS": 12,
     "VNEG": -12,
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0.93,
     1.07
    ]
   },
   {
    "name": "-3 dB near 1 kHz",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "VPOS": 12,
     "VNEG": -12,
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0.6,
     0.8
    ]
   },
   {
    "name": "-40 dB/decade: <0.02 at 10 kHz",
    "analysis": "ac",
    "freq": 10000,
    "sources": {
     "VPOS": 12,
     "VNEG": -12,
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0,
     0.02
    ]
   }
  ]
 },
 {
  "id": "inverting_amp",
  "description": "Single-supply 5 V inverting amplifier with a gain of -10 at 1 kHz, AC-coupled input and output, biased at mid-supply, able to drive a 10k load. Name the nets VCC, GND, IN and OUT.",
  "tests": [
   {
    "name": "|gain| ~10 at 1 kHz into 10k",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "VCC": 5,
     "IN": "ac"
    },
    "loads": {
     "OUT": 10000
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     8.5,
     11.5
    ]
   },
   {
    "name": "|gain| ~10 at 100 Hz into 10k",
    "analysis": "ac",
    "freq": 100,
    "sources": {
     "VCC": 5,
     "IN": "ac"
    },
    "loads": {
     "OUT": 10000
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     8.5,
     11.5
    ]
   }
  ]
 },
 {
  "id": "ce_amplifier",
  "description": "Single NPN transistor common-emitter amplifier on a 9 V supply with a voltage gain of about 20 at 1 kHz into a 10k load. Use a voltage-divider bias with emitter degeneration so the gain does not depend on the transistor's beta, and AC-couple the input and output. Name the nets VCC, GND, IN and OUT.",
  "tests": [
   {
    "name": "gain ~20 at 1 kHz into 10k",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "VCC": 9,
     "IN": "ac"
    },
    "loads": {
     "OUT": 10000
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     14,
     28
    ]
   },
   {
    "name": "gain ~20 at 100 Hz into 10k",
    "analysis": "ac",
    "freq": 100,
    "sources": {
     "VCC": 9,
     "IN": "ac"
    },
    "loads": {
     "OUT": 10000
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     14,
     28
    ]
   }
  ]
 },
 {
  "id": "led_current_source",
  "description": "Constant-current driver that keeps a white LED at 20 mA for any supply from 9 V to 15 V, built from discrete transistors (no regulator IC). Supply on a 2-pin header. Name the nets VIN and GND.",
  "tests": [
   {
    "name": "~20 mA at 9 V",
    "sources": {
     "VIN": 9
    },
    "measure": "i(VIN)",
    "expect": [
     0.018,
     0.025
    ]
   },
   {
    "name": "~20 mA at 15 V",
    "sources": {
     "VIN": 15
    },
    "measure": "i(VIN)",
    "expect": [
     0.018,
     0.025
    ]
   }
  ]
 },
 {
  "id": "zener_regulator",
  "description": "Zener shunt regulator that makes 5.1 V from a 12 V input and can supply up to 10 mA. Input and output on 2-pin headers. Name the nets VIN, OUT and GND.",
  "tests": [
   {
    "name": "5.1 V at 10 mA",
    "sources": {
     "VIN": 12
    },
    "loads": {
     "OUT": 510
    },
    "measure": "v(OUT)",
    "expect": [
     4.8,
     5.4
    ]
   },
   {
    "name": "5.1 V unloaded",
    "sources": {
     "VIN": 12
    },
    "measure": "v(OUT)",
    "expect": [
     4.8,
     5.5
    ]
   }
  ]
 },
 {
  "id": "reverse_polarity",
  "description": "Reverse-polarity protection for a 12 V, 1 A input using a P-channel MOSFET so the voltage drop is small, with the gate-source voltage kept within the MOSFET's rating. Input and output on 2-pin headers. Name the nets VIN, VOUT and GND.",
  "tests": [
   {
    "name": "passes 12 V at 1 A",
    "sources": {
     "VIN": 12
    },
    "loads": {
     "VOUT": 12
    },
    "measure": "v(VOUT)",
    "expect": [
     11.5,
     12.01
    ]
   },
   {
    "name": "blocks -12 V",
    "sources": {
     "VIN": -12
    },
    "loads": {
     "VOUT": 12
    },
    "measure": "v(VOUT)",
    "expect": [
     -0.5,
     0.5
    ]
   }
  ]
 },
 {
  "id": "diff_amp",
  "description": "Op-amp difference amplifier with a gain of 10 (OUT = 10 x (IN_P - IN_N)) on +/-12 V supplies, with good common-mode rejection. Inputs, output and power on pin headers. Name the nets IN_P, IN_N, OUT, VPOS (+12 V), VNEG (-12 V) and GND.",
  "tests": [
   {
    "name": "differential gain ~10",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "VPOS": 12,
     "VNEG": -12,
     "IN_P": "ac",
     "IN_N": 0
    },
    "measure": "gain(OUT,IN_P)",
    "expect": [
     9,
     11
    ]
   },
   {
    "name": "common-mode gain < 0.1",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "VPOS": 12,
     "VNEG": -12,
     "IN_P": "ac",
     "IN_N": "ac"
    },
    "measure": "gain(OUT,IN_P)",
    "expect": [
     0,
     0.1
    ]
   }
  ]
 }
]
