 {
  "id": "diff_amp",
  "description": "Op-amp difference amplifier with a gain of 10 (OUT = 10 x (IN_P - IN_N)) on +/-12 V supplies, with good common-mode rejection. Inputs, output and power on pin headers. Name the nets IN_P, IN_N, OUT, VPOS (+12 V), VNEG (-12 V) and GND.",
  "tests": [
   {
    "name": "differential gain ~10",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "VPOS": 12,
     "VNEG": -12,
     "IN_P": "ac",
     "IN_N": 0
    },
    "measure": "gain(OUT,IN_P)",
    "expect": [
     9,
     11
    ]
   },
   {
    "name": "common-mode gain < 0.1",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "VPOS": 12,
     "VNEG": -12,
     "IN_P": "ac",
     "IN_N": "ac"
    },
    "measure": "gain(OUT,IN_P)",
    "expect": [
     0,
     0.1
    ]
   }
  ]
 },
