    },
    "measure": "i(VCC)",
    "expect": [
     0,
     0.002
    ]
   },
   {
    "name": "no supply short at 5.5 V",
    "sources": {
     "VCC": 5.5
    },
    "measure": "i(VCC)",
    "expect": [
     0,
     0.002
    ]
   }
  ]
 },
 {
  "id": "rs485_transceiver",
  "description": "RS-485 transceiver breakout using a MAX485-compatible chip at 5 V, with a 120 ohm termination resistor, and headers for the UART side (RO, DI, DE/RE, VCC, GND) and the bus side (A, B, GND). Name the bus nets A and B, and the supply nets VCC and GND.",
  "tests": [
   {
    "name": "120 ohm termination",
    "sources": {
     "A": 1,
     "B": 0
    },
    "measure": "i(A)",
    "expect": [
     0.0077,
     0.0091
    ]
   },
   {
    "name": "120 ohm termination, B side",
    "sources": {
     "A": 0,
     "B": 1
    },
    "measure": "i(B)",
    "expect": [
     0.0077,
     0.0091
    ]
   }
  ]
 },
 {
  "id": "rc_lowpass",
  "description": "Passive first-order RC low-pass filter with a 1 kHz cutoff, input and output on 2-pin headers. Name the nets IN, OUT and GND.",
  "tests": [
   {
    "name": "-3 dB at 1 kHz",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0.64,
     0.77
    ]
   },
   {
    "name": "attenuates 10 kHz",
    "analysis": "ac",
    "freq": 10000,
    "sources": {
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0,
     0.15
    ]
   },
   {
    "name": "passes 100 Hz",
    "analysis": "ac",
    "freq": 100,
    "sources": {
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0.95,
     1.0
    ]
   }
  ]
 },
 {
  "id": "buffered_reference",
  "description": "A 2.5 V reference made from a resistor divider on a 5 V supply, buffered by an op-amp voltage follower so it can drive a 1k load. Power and the reference output on pin headers. Name the nets VCC, GND and VREF_OUT.",
  "tests": [
   {
    "name": "2.5 V into 1k",
    "sources": {
     "VCC": 5
    },
    "loads": {
     "VREF_OUT": 1000
    },
    "measure": "v(VREF_OUT)",
    "expect": [
     2.4,
     2.6
    ]
   },
   {
    "name": "2.5 V unloaded",
    "sources": {
     "VCC": 5
    },
    "measure": "v(VREF_OUT)",
    "expect": [
     2.4,
     2.6
    ]
   },
   {
    "name": "2.5 V into 10k",
    "sources": {
     "VCC": 5
    },
    "loads": {
     "VREF_OUT": 10000
    },
    "measure": "v(VREF_OUT)",
    "expect": [
     2.4,
     2.6
    ]
   }
  ]
 },
 {
  "id": "sallen_key_lowpass",
  "description": "Second-order Butterworth low-pass filter (Sallen-Key, unity gain) with a 1 kHz cutoff, using an op-amp on +/-12 V supplies. Input, output and power on pin headers. Name the nets IN, OUT, VPOS (+12 V), VNEG (-12 V) and GND.",
  "tests": [
   {
    "name": "passband ~1 at 100 Hz",
    "analysis": "ac",
    "freq": 100,
    "sources": {
     "VPOS": 12,
     "VNEG": -12,
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0.93,
     1.07
    ]
   },
   {
    "name": "-3 dB near 1 kHz",
    "analysis": "ac",
    "freq": 1000,
    "sources": {
     "VPOS": 12,
     "VNEG": -12,
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0.6,
     0.8
    ]
   },
   {
    "name": "-40 dB/decade: <0.02 at 10 kHz",
    "analysis": "ac",
    "freq": 10000,
    "sources": {
     "VPOS": 12,
     "VNEG": -12,
     "IN": "ac"
    },
    "measure": "gain(OUT,IN)",
    "expect": [
     0,
     0.02
    ]
   }
  ]
 },
 {
